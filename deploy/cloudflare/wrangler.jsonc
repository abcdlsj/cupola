// Static PWA on Cloudflare Workers (Assets). No custom route or DNS record is
// declared here: the Worker is reachable at <name>.<account>.workers.dev. Add a
// route only when the operator supplies the exact zone and two-digit subdomain.
{
  "name": "cupola",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../web/dist",
    "not_found_handling": "single-page-application"
  }
}
