[Unit]
Description=Cupola hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cupola
Group=cupola
ExecStart=/opt/cupola/cupola hub --web-dir /opt/cupola/web
EnvironmentFile=-/etc/cupola/hub.env
Restart=on-failure
RestartSec=3
# /opt/cupola stays read-only for the hub: the privileged cupola-upgrade unit
# owns upgrades (deploy/systemd/cupola-upgrade.path).
StateDirectory=cupola
ReadWritePaths=/var/lib/cupola
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
