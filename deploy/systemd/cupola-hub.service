[Unit]
Description=Cupola hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cupola
Group=cupola
ExecStart=/opt/cupola/cupola hub --web-dir /opt/cupola/web
EnvironmentFile=-/etc/cupola/hub.env
Restart=on-failure
RestartSec=3
# /opt/cupola stays read-only for the hub: the privileged cupola-upgrade unit
# owns upgrades (deploy/systemd/cupola-upgrade.path).
StateDirectory=cupola
ReadWritePaths=/var/lib/cupola
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Container metrics need /var/run/docker.sock, which is root-equivalent, so the
# group is not granted here. Opt in with deploy/install-hub.sh --docker, which
# drops SupplementaryGroups=<socket group> into
# /etc/systemd/system/cupola-hub.service.d/10-docker.conf.

[Install]
WantedBy=multi-user.target
