[Unit]
Description=Cupola hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cupola
Group=cupola
ExecStart=/usr/local/bin/cupola hub --web-dir /usr/local/share/cupola/web
EnvironmentFile=-/etc/cupola/hub.env
Restart=on-failure
RestartSec=3
StateDirectory=cupola
ReadWritePaths=/var/lib/cupola
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
