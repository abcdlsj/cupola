[Unit]
Description=Watch for a Cupola upgrade request

[Path]
# The hub writes this file atomically (write + rename), so PathChanged fires
# exactly once per request. PathExists covers a request that arrives while the
# path unit is stopped.
PathChanged=/var/lib/cupola/update.request
PathExists=/var/lib/cupola/update.request
Unit=cupola-upgrade.service

[Install]
WantedBy=multi-user.target
