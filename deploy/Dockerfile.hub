# syntax=docker/dockerfile:1
FROM node:22-bookworm AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY scripts/ scripts/
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ENV CGO_ENABLED=0
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags "-s -w -X github.com/abcdlsj/cupola/internal/version.Commit=${COMMIT:-dev}" -o /out/cupola ./cmd/cupola

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/cupola /usr/local/bin/cupola
COPY --from=web /src/web/dist /app/web
VOLUME ["/data"]
EXPOSE 8080
ENV CUPOLA_LISTEN=0.0.0.0:8080 CUPOLA_DATA_DIR=/data CUPOLA_WEB_DIR=/app/web
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/cupola"]
CMD ["hub"]
